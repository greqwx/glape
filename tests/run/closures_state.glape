define make_counter():
  n = 0
  define inc():
    n = n + 1
    return n
  return inc

define make_adder(base):
  define add(x):
    return base + x
  return add

define main():
  a = make_counter()
  b = make_counter()
  print(a())
  print(a())
  print(b())
  add5 = make_adder(5)
  print(add5(10))
  print(add5(-2))
  fns = [a, b]
  print(fns[0]())
  print(fns[1]())

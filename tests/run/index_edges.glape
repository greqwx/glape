define get_at(object, index):
  return object[index]

define set_at(object, index, value):
  object[index] = value

define main():
  matrix = [[1, 2], [3, 4]]
  print(matrix[1][0])
  data = {user: {name: "Ada"}}
  print(data.user.name)
  print(data["user"]["name"])
  set_at(data["user"], "name", "Grace")
  print(data)
  list = [1, 2]
  set_at(list, 1, 20)
  print(list)
  set_at(list, 5, 30) catch err:
    print("caught: $err")
  set_at(list, -1, 0) catch err:
    print("caught: $err")
  get_at(list, "x") catch err:
    print("caught: $err")
  text = "abc"
  set_at(text, 0, "z") catch err:
    print("caught: $err")
  get_at(text, 3) catch err:
    print("caught: $err")
  number = 1
  get_at(number, 0) catch err:
    print("caught: $err")
  mapping = {}
  get_at(mapping, 1) catch err:
    print("caught: $err")
  get_at(mapping, "missing") catch err:
    print("caught: $err")
  euro = "\xE2\x82\xAC"
  print(len(euro))
  print(euro[0] == "\xE2")
  print(euro[1] == "\x82")
  print(euro[2] == "\xAC")

define add(a, b):
  return a + b

define sub(a, b):
  return a - b

define mul(a, b):
  return a * b

define div(a, b):
  return a / b

define mod(a, b):
  return a % b

define neg(a):
  return -a

define rem(a, b):
  return a % b

define main():
  print(7 / 2)
  print(-7 / 2)
  print(7 / -2)
  print(-7 / -2)
  print(7 % 3)
  print(-7 % 3)
  print(7 % -3)
  print(-7 % -3)
  print(7.5 % 2)
  print(-7.5 % 2)
  print(1 + 2.5)
  print(2.5 + 1)
  print(3 * 1.5)
  print(2 / 4)
  print(2.0 / 4)
  print(1e308 * 10)
  print(10 / 0.5)
  add(9223372036854775807, 1) catch err:
    print("caught: $err")
  sub(-9223372036854775807 - 1, 1) catch err:
    print("caught: $err")
  mul(9223372036854775807, 2) catch err:
    print("caught: $err")
  div(-9223372036854775807 - 1, -1) catch err:
    print("caught: $err")
  mod(-9223372036854775807 - 1, -1) catch err:
    print("caught: $err")
  neg(-9223372036854775807 - 1) catch err:
    print("caught: $err")
  rem(1.5, 0) catch err:
    print("caught: $err")
  print(to_int(3.9))
  print(to_int(-3.9))
  to_int(1e300) catch err:
    print("caught: $err")
  to_int(to_float("nan")) catch err:
    print("caught: $err")

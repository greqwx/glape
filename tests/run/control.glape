define classify(n):
  if n < 0:
    return "negative"
  if n == 0:
    return "zero"
  return "positive"

define main(args):
  print(len(args))
  loop n in [-2, 0, 5]:
    if n == 0:
      skip
    print(classify(n))
  total = 0
  loop n in [-2, 0, 5]:
    total = total + n
  print(total)
  print(1 + 2 * 3)
  print(10 / 4)
  print(10.0 / 4)
  print(7 % 3)

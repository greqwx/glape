define main():
  print(1 + 2 * 3)
  print((1 + 2) * 3)
  print(10 / 4)
  print(10.0 / 4)
  print(7 % 3)
  print(-7 % 3)
  print(7.5 % 2)
  print(2 + 3.5)
  print(2 * 2.0)
  print(-5)
  print(- -5)
  print(not true)
  print(not not true)
  print(1 < 2)
  print(1 <= 1)
  print(2 > 1)
  print(2 >= 2)
  print("abc" < "abd")
  print("a" < "aa")
  print(1 == 1.0)
  print(1 != 2)
  print(true and "x")
  print(false or "y")
  print(nil or 42)
  print(0 and 5)
  print(false and fail("no"))
  print(true or fail("no"))
  print([1] + [2, 3])
  print("n=" + 5)
  print(5 + "!")

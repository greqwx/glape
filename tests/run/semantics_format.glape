load list

define main():
  print(1.0)
  print(2.5)
  print(1000000.0)
  print(0.000001)
  print(0.0000001)
  print(to_float("inf"))
  print(to_float("-inf"))
  print(to_float("nan"))
  print([1.0, "x", true, nil])
  print({a: [1, {b: 2}]})
  print([[[]]])
  a = []
  list.push(a, a)
  print(a)
  m = {}
  m["self"] = m
  print(m)

load list

define churn():
  seeds = [1, 2, 3, 4, 5, 6, 7, 8]
  count = 0
  loop a in seeds:
    loop b in seeds:
      loop c in seeds:
        loop d in seeds:
          group = ["alpha", "beta", "gamma"]
          record = {a: a, b: b, c: c, d: d, items: group}
          cycle = [a, b, c, d]
          list.push(cycle, cycle)
          define descend(n):
            if n <= 0:
              return 0
            return descend(n - 1)
          count = count + 1
  return count

define main():
  print(churn())
